---
// BaseLayout.astro - Shared layout for all pages
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  bodyClass?: string;
}

const { 
  title, 
  description = "Báo cáo thị trường Crypto hàng ngày, phân tích chuyên sâu về công nghệ Blockchain, và các xu hướng mới nhất trong Web3.",
  ogImage = "https://escbase.xyz/og-default.png",
  ogUrl = "https://escbase.xyz/",
  bodyClass = ""
} = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Escbase</title>
    <meta name="description" content={description}>
    
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Escbase">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={ogUrl}>
    <meta property="og:image" content={ogImage}>
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@escbase">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    
    <slot name="head" />
</head>

<body class={bodyClass}>
    <div class="app-container">
        <!-- Mobile Header -->
        <header class="mobile-header">
            <a href="/" class="mobile-logo">
                <img src="/esclogo.png" alt="Escbase - Trang phân tích Crypto hàng ngày">
                <span>Escbase</span>
            </a>
            <button class="hamburger" onclick="toggleMobileNav()" aria-label="Mở menu điều hướng">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </header>

        <!-- Mobile Nav Overlay -->
        <nav class="mobile-nav" id="mobileNav">
            <a href="/" class="nav-item" onclick="toggleMobileNav()"><i class="fas fa-home"></i> Trang chủ</a>
            <a href="/blog" class="nav-item" onclick="toggleMobileNav()"><i class="fas fa-newspaper"></i> Bài viết</a>
            <a href="/videos" class="nav-item" onclick="toggleMobileNav()"><i class="fas fa-play-circle"></i> Video</a>
            <div class="social-links">
                <a href="https://www.youtube.com/@ESCBase" target="_blank" class="social-btn" title="YouTube"><i class="fab fa-youtube"></i></a>
                <a href="https://x.com/escbasexyz" target="_blank" class="social-btn" title="X (Twitter)"><i class="fa-brands fa-x-twitter"></i></a>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="sidebar">
            <a href="/" class="brand">
                <img src="/esclogo.png" alt="Escbase - Trang phân tích Crypto hàng ngày">
                <div class="brand-info">
                    <h1>Escbase</h1>
                    <p>Crypto Intelligence</p>
                </div>
            </a>

            <ul class="nav-menu">
                <li><a href="/" class="nav-item" id="nav-home"><i class="fas fa-home"></i> Trang chủ</a></li>
                <li><a href="/blog" class="nav-item" id="nav-blog"><i class="fas fa-newspaper"></i> Bài viết</a></li>
                <li><a href="/videos" class="nav-item" id="nav-videos"><i class="fas fa-video"></i> Video</a></li>
            </ul>
            <div class="social-links">
                <a href="https://www.youtube.com/@ESCBase" target="_blank" class="social-btn" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                <a href="https://x.com/escbasexyz" target="_blank" class="social-btn" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <slot />
            
            <footer class="site-footer">
                <p>&copy; 2026 Escbase. Crypto Góc Nhìn Mỗi Ngày & Analysis.</p>
            </footer>
        </main>
    </div>

    <script is:inline src="/shared-layout.js"></script>
    <script is:inline>
        // Mobile nav toggle
        function toggleMobileNav() {
            const nav = document.getElementById('mobileNav');
            const hamburger = document.querySelector('.hamburger');
            nav.classList.toggle('open');
            hamburger.classList.toggle('active');
            document.body.style.overflow = nav.classList.contains('open') ? 'hidden' : '';
        }
        
        // Set active nav item based on current page
        document.addEventListener('DOMContentLoaded', () => {
            const path = window.location.pathname;
            if (path === '/' || path === '') {
                document.getElementById('nav-home')?.classList.add('active');
            } else if (path.startsWith('/blog')) {
                document.getElementById('nav-blog')?.classList.add('active');
            } else if (path.startsWith('/videos')) {
                document.getElementById('nav-videos')?.classList.add('active');
            }
        });
    </script>
</body>
</html>
