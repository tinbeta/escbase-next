---
// pages/blog/index.astro - Blog listing page
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Get unique tags
const tagMap = new Map();
posts.forEach(p => {
  if (!tagMap.has(p.data.tag)) {
    tagMap.set(p.data.tag, { tag: p.data.tag, color: p.data.tagColor, count: 0 });
  }
  tagMap.get(p.data.tag).count++;
});
const tags = Array.from(tagMap.values());
---

<BaseLayout 
  title="Bài viết" 
  description="Tất cả bài viết phân tích thị trường Crypto, blockchain, AI và geopolitics trên Escbase."
  ogUrl="https://escbase.xyz/blog"
>
  <style slot="head">
    .page-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .page-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }
    .page-header h1 {
      font-size: 2rem;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .page-header p {
      color: var(--text-muted);
      font-size: 1rem;
    }
    
    .tag-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      padding: 1rem 0;
    }
    .tag-filter-btn {
      padding: 0.4rem 1rem;
      border-radius: 99px;
      font-size: 0.8rem;
      font-weight: 500;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.3s;
      text-decoration: none;
    }
    .tag-filter-btn:hover,
    .tag-filter-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--bg);
    }
    
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .post-card {
      display: block;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.3s;
    }
    .post-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    }
    .post-card.hidden { display: none; }
    .post-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    .post-tag {
      padding: 0.25rem 0.6rem;
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px solid;
    }
    .post-card h3 {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }
    .post-card p {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 0.75rem;
    }
    .post-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: auto;
    }
    
    @media (max-width: 768px) {
      .posts-grid { grid-template-columns: 1fr; }
    }
  </style>

  <header class="page-header">
    <span class="page-label">Bài viết</span>
    <h1>Tất cả bài viết trên Escbase</h1>
    <p>Phân tích crypto, blockchain, AI và các chuyển động đáng chú ý của thị trường theo kiểu ngắn gọn, dễ đọc.</p>
  </header>

  <div class="tag-filter">
    <button class="tag-filter-btn active" data-tag="all">Tất cả ({posts.length})</button>
    {tags.map(t => (
      <button class="tag-filter-btn" data-tag={t.tag} style={`--tag-color: ${t.color}`}>
        {t.tag} ({t.count})
      </button>
    ))}
  </div>

  <div class="posts-grid" id="postsGrid">
    {posts.map(post => (
        <a class="post-card" href={`/blog/${post.id}`} data-tags={post.data.tag}>
        <div class="post-meta">
          <span class="post-tag" style={`color: ${post.data.tagColor}; border-color: ${post.data.tagColor}44; background: ${post.data.tagColor}1a;`}>
            <i class={post.data.tagIcon || 'fas fa-newspaper'}></i> {post.data.tag}
          </span>
          <span>{post.data.date}</span>
        </div>
        <h3>{post.data.title}</h3>
        <p>{post.data.excerpt}</p>
        <div class="post-footer">
          <span><i class="far fa-clock"></i> {post.data.readTime}</span>
          <span>→</span>
        </div>
      </a>
    ))}
  </div>

  <script is:inline>
    // Tag filter functionality
    const filterBtns = document.querySelectorAll('.tag-filter-btn');
    const postCards = document.querySelectorAll('.post-card');
    
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        
        // Update active state
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Filter posts
        postCards.forEach(card => {
          if (tag === 'all' || card.dataset.tags === tag) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</BaseLayout>
