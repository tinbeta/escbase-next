---
// pages/index.astro - Homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const featuredPost = posts.find(p => p.data.featured) || posts[0];
const latestPosts = posts.filter(p => p.slug !== featuredPost?.slug).slice(0, 3);

const uniqueTags = [...new Set(posts.map(p => p.data.tag))].slice(0, 5);
const tagColors = [...new Set(posts.map(p => ({ tag: p.data.tag, color: p.data.tagColor })))].filter((v, i, a) => a.findIndex(t => t.tag === v.tag) === i).slice(0, 5);
---

<BaseLayout 
  title="Trang chủ" 
  description="Báo cáo thị trường Crypto hàng ngày, phân tích chuyên sâu về công nghệ Blockchain, và các xu hướng mới nhất trong Web3."
  ogUrl="https://escbase.xyz/"
>
  <style slot="head">
    /* Hero Section */
    .hero {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 4rem 3rem;
      margin-bottom: 3rem;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 0% 0%, var(--accent-glow) 0%, transparent 50%);
      opacity: 0.8;
      pointer-events: none;
    }
    .hero-bg-pattern {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(var(--border) 1px, transparent 1px);
      background-size: 24px 24px;
      opacity: 0.4;
      pointer-events: none;
    }
    .hero-content { position: relative; z-index: 1; max-width: 700px; }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 1rem;
      background: rgba(247, 147, 26, 0.1);
      color: var(--accent);
      border-radius: 99px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      border: 1px solid rgba(247, 147, 26, 0.2);
      letter-spacing: 0.02em;
    }
    .hero h2 {
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin-bottom: 1.25rem;
    }
    .hero p {
      font-size: 1.15rem;
      color: var(--text-secondary);
      margin-bottom: 2rem;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--text);
      color: var(--bg);
      padding: 0.875rem 1.5rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-primary:hover { transform: scale(1.05); background: #fff; }
    .ghost-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      color: var(--text);
      padding: 0.875rem 1.5rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      text-decoration: none;
      border: 1px solid var(--border);
      transition: all 0.2s;
      margin-left: 0.75rem;
    }
    .ghost-btn:hover { border-color: var(--accent); color: var(--accent); }
    .live-readers {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin-top: 1rem;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--text-secondary);
      font-size: 0.92rem;
      backdrop-filter: blur(8px);
    }
    .live-dot {
      width: 10px; height: 10px; border-radius: 999px;
      background: #22c55e;
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
      animation: pulse-live 1.8s infinite;
    }
    @keyframes pulse-live {
      0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.65); }
      70% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); }
      100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
    }
    .animate-text {
      color: var(--accent);
      border-right: 3px solid var(--accent);
      padding-right: 5px;
      animation: blink 0.7s infinite;
    }
    @keyframes blink { 50% { border-color: transparent; } }
    
    .hero-panel-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-top: 2rem;
    }
    .hero-mini-panel {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
    }
    .mini-kicker {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
    }
    .stat-row {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .stat-row strong {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text);
    }
    .stat-row span { font-size: 0.85rem; color: var(--text-muted); }
    .topic-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .topic-chip {
      padding: 0.35rem 0.75rem;
      border-radius: 99px;
      font-size: 0.8rem;
      font-weight: 500;
      border: 1px solid;
    }
    
    /* Section blocks */
    .section-block { margin-bottom: 3rem; }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .section-kicker {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }
    .section-head h3 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
    }
    .section-head a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s;
    }
    .section-head a:hover { color: var(--accent); }
    
    /* Cards */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .content-card {
      display: block;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.3s;
    }
    .content-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    }
    .meta-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    .tag-chip {
      padding: 0.25rem 0.6rem;
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px solid;
    }
    .content-card h4 {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }
    .content-card p {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 0.75rem;
    }
    .bottom-row { margin-top: auto; justify-content: space-between; }
    
    /* Featured block */
    .featured-block { margin-bottom: 3rem; }
    .featured-story {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 2rem;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 2rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.3s;
    }
    .featured-story:hover { border-color: var(--accent); }
    .featured-copy h4 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }
    .featured-copy p {
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }
    .featured-side-note {
      background: rgba(255,255,255,0.03);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
    }
    .featured-side-note p {
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.5;
    }
    
    @media (max-width: 768px) {
      .hero { padding: 2.5rem 1.5rem; }
      .hero h2 { font-size: 2rem; }
      .hero-panel-grid { grid-template-columns: 1fr; }
      .card-grid { grid-template-columns: 1fr; }
      .featured-story { grid-template-columns: 1fr; }
      .ghost-btn { margin-left: 0; margin-top: 0.5rem; }
      .hero-cta-group { flex-direction: column; align-items: flex-start; }
    }
  </style>

  <section class="hero hero-grid">
    <div class="hero-bg-pattern"></div>
    <div class="hero-content">
      <div class="badge"><i class="fas fa-bolt"></i> Góc Nhìn Mỗi Ngày</div>
      <h2>Phân Tích Chuyên Sâu &amp; <br><span class="animate-text"></span></h2>
      <p>Cập nhật những chuyển động quan trọng nhất của thị trường, ETF flows, và đột phá công nghệ blockchain mỗi ngày.</p>
      <div class="hero-cta-group">
        <a class="btn-primary" href="/blog">Xem bài viết</a>
        <a class="ghost-btn" href="/videos">Xem video</a>
      </div>
      <div class="live-readers" id="liveReadersBadge" aria-live="polite">
        <span class="live-dot" aria-hidden="true"></span>
        <span><strong id="liveReadersCount">--</strong> người đang online đọc web</span>
      </div>
    </div>

    <div class="hero-panel-grid">
      <div class="hero-mini-panel stats-panel">
        <span class="mini-kicker">Snapshot</span>
        <div class="stat-row">
          <strong>{posts.length}+</strong>
          <span>bài phân tích</span>
        </div>
        <div class="stat-row">
          <strong>200+</strong>
          <span>video nổi bật</span>
        </div>
        <div class="stat-row">
          <strong>{uniqueTags.length}</strong>
          <span>cụm chủ đề chính</span>
        </div>
      </div>

      <div class="hero-mini-panel topic-panel">
        <span class="mini-kicker">Narratives đang chạy</span>
        <div class="topic-list">
          {tagColors.map(tc => (
            <span class="topic-chip" style={`color: ${tc.color}; border-color: ${tc.color}44`}>
              {tc.tag}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  {featuredPost && (
    <section class="section-block featured-block">
      <div class="section-head">
        <div>
          <span class="section-kicker">Featured story</span>
          <h3>Bài đang đáng đọc nhất</h3>
        </div>
        <a href={`/blog/${featuredPost.id}`}>Mở bài</a>
      </div>

      <a class="featured-story" href={`/blog/${featuredPost.id}`}>
        <div class="featured-copy">
          <div class="meta-row">
            <span class="tag-chip" style={`color: ${featuredPost.data.tagColor}; border-color: ${featuredPost.data.tagColor}44`}>
              <i class={featuredPost.data.tagIcon}></i> {featuredPost.data.tag}
            </span>
            <span>{featuredPost.data.date}</span>
          </div>
          <h4>{featuredPost.data.title}</h4>
          <p>{featuredPost.data.excerpt}</p>
          <div class="meta-row bottom-row">
            <span>{featuredPost.data.readTime}</span>
            <span>→</span>
          </div>
        </div>

        <div class="featured-side-note">
          <span class="mini-kicker">Tại sao nó nên ở vị trí này?</span>
          <p>
            Homepage cần một điểm neo biên tập rõ ràng. Nếu không có lead story, toàn bộ trang
            sẽ trông như feed ngẫu nhiên — đọc xong không nhớ được Escbase đang ưu tiên điều gì.
          </p>
        </div>
      </a>
    </section>
  )}

  <section class="section-block">
    <div class="section-head">
      <div>
        <span class="section-kicker">Bài viết</span>
        <h3>3 bài mới để quét nhanh</h3>
      </div>
      <a href="/blog">Xem tất cả</a>
    </div>

    <div class="card-grid three-up">
      {latestPosts.map(post => (
        <a class="content-card" href={`/blog/${post.id}`}>
          <div class="meta-row">
            <span class="tag-chip" style={`color: ${post.data.tagColor}; border-color: ${post.data.tagColor}44`}>
              <i class={post.data.tagIcon}></i> {post.data.tag}
            </span>
            <span>{post.data.date}</span>
          </div>
          <h4>{post.data.title}</h4>
          <p>{post.data.excerpt}</p>
          <div class="meta-row bottom-row">
            <span>{post.data.readTime}</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block">
    <div class="section-head">
      <div>
        <span class="section-kicker">Video</span>
        <h3>Video mới nhất</h3>
      </div>
      <a href="/videos">Xem tất cả</a>
    </div>
    <div id="videosGrid" class="card-grid three-up">
      {/* Videos loaded client-side from videos-feed.json */}
      <div style="color: var(--text-muted); font-size: 0.9rem; grid-column: 1 / -1;">
        Đang tải video...
      </div>
    </div>
  </section>

  <script is:inline>
    // Text cycling animation
    const words = ["Crypto Reports", "Blockchain Tech", "Web3 Trends", "Market Insights"];
    let i = 0, j = 0, currentWord = "", isDeleting = false;
    const textElement = document.querySelector(".animate-text");
    function type() {
      currentWord = words[i];
      if (isDeleting) {
        textElement.textContent = currentWord.substring(0, j - 1);
        j--;
        if (j === 0) { isDeleting = false; i = (i + 1) % words.length; }
      } else {
        textElement.textContent = currentWord.substring(0, j + 1);
        j++;
        if (j === currentWord.length) { isDeleting = true; setTimeout(type, 2000); return; }
      }
      setTimeout(type, isDeleting ? 100 : 200);
    }
    if (textElement) type();

    // Load videos
    fetch('/videos-feed.json')
      .then(r => r.json())
      .then(videos => {
        const dedupe = (items) => {
          const seen = new Set();
          return items.filter(v => {
            const n = (v.title || '').replace(/\s*-\s*full\s*$/i, '').trim().toLowerCase();
            if (seen.has(n)) return false;
            seen.add(n);
            return true;
          });
        };
        const shown = dedupe(videos).slice(0, 3);
        const grid = document.getElementById('videosGrid');
        grid.innerHTML = shown.map(video => `
          <a class="content-card video-card" href="${video.url}" target="_blank" rel="noreferrer">
            <div style="aspect-ratio:16/9; overflow:hidden; border-radius:8px; margin-bottom:0.75rem; background:#111;">
              <img src="${video.thumb}" alt="${video.title}" style="width:100%; height:100%; object-fit:cover; display:block;">
            </div>
            <div class="meta-row">
              <span class="tag-chip" style="background:rgba(239,68,68,0.12); color:#ef4444; border-color:rgba(239,68,68,0.24);">
                <i class="fab fa-youtube"></i> YouTube
              </span>
              <span>${video.published || ''}</span>
            </div>
            <h4>${video.title}</h4>
            <p>Video mới nhất từ kênh Escbase trên YouTube.</p>
            <div class="meta-row bottom-row">
              <span>Xem video</span>
              <span>→</span>
            </div>
          </a>
        `).join('');
      })
      .catch(() => {
        document.getElementById('videosGrid').innerHTML = '<p style="color:var(--text-muted);">Không thể tải video.</p>';
      });

    // Live readers count
    fetch('/api/online-now')
      .then(r => r.json())
      .then(data => {
        const el = document.getElementById('liveReadersCount');
        if (el && data.count) el.textContent = data.count;
      })
      .catch(() => {});
  </script>
</BaseLayout>