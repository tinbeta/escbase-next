---
// pages/landing/index.astro - Petal Doctrine landing page
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Petal Doctrine" 
  description="Petal Doctrine — An editorial floral atelier crafting immersive botanical experiences, workshops, and commissioned works."
  ogUrl="https://escbase.xyz/landing"
>
  <style slot="head">
    /* Override base styles for this page */
    .app-container { display: block; }
    .sidebar { display: none; }
    .main-content { margin-left: 0; max-width: 100%; }
    .site-footer { display: none; }
    
    :root {
      --petal-bg: #0a0a0a;
      --petal-accent: #c9a87c;
      --petal-text: #f5f0eb;
      --petal-muted: #8a8279;
    }
  </style>

  <div style="background: var(--petal-bg); min-height: 100vh; color: var(--petal-text); font-family: 'Inter', sans-serif;">
    <!-- Navigation -->
    <nav style="position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 1.5rem 3rem; display: flex; align-items: center; justify-content: space-between; background: transparent; transition: background 0.6s ease;">
      <a href="#" style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.35rem; font-weight: 500; letter-spacing: 0.02em; color: var(--petal-text); text-decoration: none; display: flex; align-items: center; gap: 0.75rem;">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--petal-accent); display: inline-block;"></span>
        Petal Doctrine
      </a>
      <div style="display: flex; gap: 2.5rem;">
        <a href="#works" style="color: var(--petal-muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.4s;">Works</a>
        <a href="#services" style="color: var(--petal-muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.4s;">Services</a>
        <a href="#workshops" style="color: var(--petal-muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.4s;">Workshops</a>
        <a href="#inquiry" style="color: var(--petal-muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.4s;">Inquiry</a>
      </div>
      <a href="#inquiry" style="padding: 0.6rem 1.4rem; border: 1px solid rgba(201, 168, 124, 0.2); border-radius: 6px; color: var(--petal-text); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: all 0.4s;">Get in Touch</a>
    </nav>

    <!-- Hero -->
    <section id="hero" style="position: relative; height: 100vh; min-height: 700px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--petal-bg);">
      <div style="position: absolute; inset: 0; z-index: 1;">
        <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 80% 50% at 20% 40%, rgba(201, 168, 124, 0.08) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 80% 60%, rgba(180, 140, 100, 0.06) 0%, transparent 50%); animation: heroGlow 12s ease-in-out infinite alternate;"></div>
      </div>
      <div style="position: absolute; inset: 0; z-index: 2; opacity: 0.04; background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\'/%3E%3C/svg%3E'); pointer-events: none;"></div>
      <div style="position: absolute; inset: 0; z-index: 3; background: radial-gradient(ellipse at center, transparent 40%, rgba(10, 10, 10, 0.6) 100%); pointer-events: none;"></div>

      <div style="position: relative; z-index: 10; text-align: center; max-width: 800px; padding: 0 2rem;">
        <div style="display: inline-flex; align-items: center; gap: 0.75rem; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--petal-accent); margin-bottom: 2rem;">
          <span style="width: 40px; height: 1px; background: var(--petal-accent); opacity: 0.4;"></span>
          Floral Atelier & Studio
          <span style="width: 40px; height: 1px; background: var(--petal-accent); opacity: 0.4;"></span>
        </div>
        <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(3rem, 7vw, 6rem); font-weight: 400; line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 1.5rem; color: var(--petal-text);">
          Where Nature<br>Meets <em style="color: var(--petal-accent);">Intention</em>
        </h1>
        <p style="font-size: clamp(1rem, 1.5vw, 1.25rem); font-weight: 300; color: var(--petal-muted); max-width: 520px; margin: 0 auto 2.5rem; line-height: 1.7;">
          Crafting immersive botanical experiences through commissioned works, editorial styling, and intimate workshops.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; align-items: center; flex-wrap: wrap;">
          <a href="#works" style="padding: 0.9rem 2.2rem; background: var(--petal-accent); color: var(--petal-bg); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; border-radius: 6px; border: 1px solid var(--petal-accent); transition: all 0.5s;">Explore Works</a>
          <a href="#inquiry" style="padding: 0.9rem 2.2rem; background: transparent; color: var(--petal-text); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; border-radius: 6px; border: 1px solid rgba(201, 168, 124, 0.2); transition: all 0.5s;">Start a Project</a>
        </div>
      </div>
    </section>

    <!-- Works -->
    <section id="works" style="padding: 8rem 3rem; background: #111;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 5rem;">
          <span style="display: inline-block; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--petal-accent); margin-bottom: 1rem;">Selected Works</span>
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; line-height: 1.15; color: var(--petal-text); margin-bottom: 1rem;">
            Botanical <em style="color: var(--petal-accent);">Compositions</em>
          </h2>
          <p style="font-size: 1.05rem; font-weight: 300; color: var(--petal-muted); max-width: 560px; margin: 0 auto; line-height: 1.7;">
            A curated selection of our most meaningful projects — from intimate ceremonies to large-scale editorial installations.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
          {[
            { tag: 'Editorial', title: 'The Wilted Archive', meta: 'Vogue Living — Spring Issue', img: 'https://images.unsplash.com/photo-1490750967868-88aa2f44fe0f?w=600&h=800&fit=crop&q=80' },
            { tag: 'Installation', title: 'Ephemeral Garden', meta: 'Saatchi Gallery, London', img: 'https://images.unsplash.com/photo-1526047932273-341f2a7631f9?w=600&h=800&fit=crop&q=80' },
            { tag: 'Ceremony', title: 'The Quiet Vow', meta: 'Private Estate, Tuscany', img: 'https://images.unsplash.com/photo-1462275646964-a0e3f2d62b5e?w=600&h=800&fit=crop&q=80' },
            { tag: 'Workshop', title: 'Pressed Memories', meta: 'Seasonal Masterclass Series', img: 'https://images.unsplash.com/photo-1487530811176-3780de880c2d?w=600&h=800&fit=crop&q=80' },
            { tag: 'Residential', title: 'Living with Bloom', meta: 'Notting Hill Residence', img: 'https://images.unsplash.com/photo-1508610048659-a06b669e3321?w=600&h=800&fit=crop&q=80' },
            { tag: 'Brand', title: 'Aesop x Petal', meta: 'Campaign Still Life', img: 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=600&h=800&fit=crop&q=80' },
          ].map(work => (
            <div style="position: relative; aspect-ratio: 3/4; border-radius: 12px; overflow: hidden; background: #141414; border: 1px solid rgba(201, 168, 124, 0.06); cursor: pointer; transition: all 0.6s;">
              <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10, 10, 10, 0.9) 0%, rgba(10, 10, 10, 0.3) 40%, transparent 100%); z-index: 2;"></div>
              <div style="position: absolute; inset: 0; background-size: cover; background-position: center; background-image: url({work.img}); transition: transform 0.8s;"></div>
              <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; z-index: 3;">
                <span style="display: inline-block; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--petal-accent); margin-bottom: 0.75rem; padding: 0.3rem 0.8rem; border: 1px solid rgba(201, 168, 124, 0.12); border-radius: 6px; background: rgba(201, 168, 124, 0.08);">{work.tag}</span>
                <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.4rem; font-weight: 500; line-height: 1.25; color: var(--petal-text); margin-bottom: 0.5rem;">{work.title}</h3>
                <p style="font-size: 0.85rem; color: var(--petal-muted); font-weight: 300;">{work.meta}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" style="padding: 8rem 3rem; background: var(--petal-bg);">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 5rem;">
          <span style="display: inline-block; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--petal-accent); margin-bottom: 1rem;">What We Do</span>
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; line-height: 1.15; color: var(--petal-text); margin-bottom: 1rem;">
            Our <em style="color: var(--petal-accent);">Services</em>
          </h2>
          <p style="font-size: 1.05rem; font-weight: 300; color: var(--petal-muted); max-width: 560px; margin: 0 auto; line-height: 1.7;">
            From concept to installation, we guide each project with meticulous attention to seasonal rhythm and spatial harmony.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
          {[
            { icon: 'fa-leaf', title: 'Floral Design', desc: 'Bespoke arrangements for ceremonies, events, and editorial shoots. Each composition is seasonally led and site-specific.', items: ['Wedding & ceremony florals', 'Editorial & campaign styling', 'Corporate & hospitality', 'Private commissions'] },
            { icon: 'fa-layer-group', title: 'Spatial Installation', desc: 'Large-scale botanical installations that transform galleries, retail spaces, and private residences into immersive environments.', items: ['Gallery & museum installations', 'Retail window & interior', 'Pop-up & event activation', 'Residential styling'] },
            { icon: 'fa-camera', title: 'Creative Direction', desc: 'Full-service creative direction for brands seeking a botanical aesthetic — from mood boards to final still life photography.', items: ['Brand campaign concepts', 'Still life & product styling', 'Art direction for print', 'Lookbook & catalogue'] },
            { icon: 'fa-seedling', title: 'Sourcing & Consulting', desc: 'Rare and seasonal flower sourcing for discerning clients. We maintain direct relationships with growers across Europe and Japan.', items: ['Seasonal sourcing calendars', 'Import & logistics', 'Studio setup consulting', 'Team training'] },
          ].map(service => (
            <div style="padding: 3rem; background: #111; border: 1px solid rgba(201, 168, 124, 0.06); border-radius: 12px; transition: all 0.5s; position: relative; overflow: hidden;">
              <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 6px; background: rgba(201, 168, 124, 0.08); border: 1px solid rgba(201, 168, 124, 0.12); color: var(--petal-accent); font-size: 1.2rem; margin-bottom: 1.5rem;">
                <i class={`fas ${service.icon}`}></i>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; font-weight: 500; color: var(--petal-text); margin-bottom: 0.75rem;">{service.title}</h3>
              <p style="font-size: 0.95rem; color: var(--petal-muted); line-height: 1.7; margin-bottom: 1.5rem;">{service.desc}</p>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem;">
                {service.items.map(item => (
                  <li style="font-size: 0.85rem; color: #5c554d; display: flex; align-items: center; gap: 0.6rem;">
                    <span style="width: 5px; height: 5px; border-radius: 50%; background: var(--petal-accent); opacity: 0.5;"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Workshops -->
    <section id="workshops" style="padding: 8rem 3rem; background: #111;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 5rem;">
          <span style="display: inline-block; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--petal-accent); margin-bottom: 1rem;">Upcoming</span>
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; line-height: 1.15; color: var(--petal-text); margin-bottom: 1rem;">
            Workshops & <em style="color: var(--petal-accent);">Intensives</em>
          </h2>
          <p style="font-size: 1.05rem; font-weight: 300; color: var(--petal-muted); max-width: 560px; margin: 0 auto; line-height: 1.7;">
            Small-group sessions led by our founder. Learn the philosophy and technique behind our signature botanical style.
          </p>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {[
            { day: '12', month: 'May 2026', title: 'The Foundations of Ikebana', badge: 'Open', badgeClass: 'open', desc: 'A full-day introduction to Japanese floral philosophy — form, line, and the beauty of negative space.' },
            { day: '24', month: 'May 2026', title: 'Seasonal Foraging & Arrangement', badge: '4 spots left', badgeClass: 'limited', desc: 'Morning field walk followed by hands-on arrangement using wild-gathered botanicals. Spring edition.' },
            { day: '08', month: 'Jun 2026', title: 'Editorial Styling Masterclass', badge: 'Sold Out', badgeClass: 'sold-out', desc: 'Two-day intensive on lighting, composition, and prop styling for botanical editorial photography.' },
            { day: '21', month: 'Jun 2026', title: 'Dried & Preserved: Extended Beauty', badge: 'Open', badgeClass: 'open', desc: 'Techniques for drying, pressing, and preserving flowers. Create arrangements that last beyond the season.' },
          ].map(workshop => (
            <div style="display: grid; grid-template-columns: 120px 1fr auto; align-items: center; gap: 2rem; padding: 2rem 2.5rem; background: var(--petal-bg); border: 1px solid rgba(201, 168, 124, 0.06); border-radius: 12px; transition: all 0.5s;">
              <div style="text-align: center;">
                <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 2.5rem; font-weight: 600; color: var(--petal-accent); line-height: 1;">{workshop.day}</div>
                <div style="font-size: 0.75rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--petal-muted); margin-top: 0.25rem;">{workshop.month}</div>
              </div>
              <div>
                <h4 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.25rem; font-weight: 500; color: var(--petal-text); margin-bottom: 0.4rem;">
                  {workshop.title}
                  <span style={`display: inline-block; font-size: 0.65rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.25rem 0.6rem; border-radius: 6px; margin-left: 0.75rem; ${workshop.badgeClass === 'sold-out' ? 'background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);' : workshop.badgeClass === 'open' ? 'background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.2);' : 'background: rgba(201, 168, 124, 0.1); color: var(--petal-accent); border: 1px solid rgba(201, 168, 124, 0.12);'}`}>{workshop.badge}</span>
                </h4>
                <p style="font-size: 0.9rem; color: var(--petal-muted);">{workshop.desc}</p>
              </div>
              <a href="#inquiry" style="padding: 0.6rem 1.4rem; border: 1px solid rgba(201, 168, 124, 0.12); border-radius: 6px; color: var(--petal-muted); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: all 0.4s; white-space: nowrap;">{workshop.badgeClass === 'sold-out' ? 'Waitlist' : 'Register'}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Inquiry -->
    <section id="inquiry" style="padding: 8rem 3rem; background: var(--petal-bg);">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; max-width: 1000px; margin: 0 auto;">
        <div>
          <span style="display: inline-block; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--petal-accent); margin-bottom: 1rem;">Start a Conversation</span>
          <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 400; line-height: 1.2; color: var(--petal-text); margin-bottom: 1.5rem;">
            Let's Create Something<br><em style="color: var(--petal-accent);">Beautiful</em> Together
          </h3>
          <p style="font-size: 1rem; color: var(--petal-muted); line-height: 1.7; margin-bottom: 2rem;">
            Whether you're planning an intimate ceremony, a brand campaign, or simply want to learn the craft — we'd love to hear from you.
          </p>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.9rem; color: var(--petal-muted);">
              <div style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 6px; background: rgba(201, 168, 124, 0.08); border: 1px solid rgba(201, 168, 124, 0.12); color: var(--petal-accent); font-size: 0.9rem;">
                <i class="fas fa-envelope"></i>
              </div>
              <span>hello@petaldoctrine.studio</span>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.9rem; color: var(--petal-muted);">
              <div style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 6px; background: rgba(201, 168, 124, 0.08); border: 1px solid rgba(201, 168, 124, 0.12); color: var(--petal-accent); font-size: 0.9rem;">
                <i class="fas fa-location-dot"></i>
              </div>
              <span>Shoreditch, London E2</span>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.9rem; color: var(--petal-muted);">
              <div style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 6px; background: rgba(201, 168, 124, 0.08); border: 1px solid rgba(201, 168, 124, 0.12); color: var(--petal-accent); font-size: 0.9rem;">
                <i class="fab fa-instagram"></i>
              </div>
              <span>@petaldoctrine</span>
            </div>
          </div>
        </div>

        <form onsubmit="event.preventDefault(); alert('Thank you for your inquiry. We will be in touch within 48 hours.');" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
              <label style="display: block; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--petal-muted); margin-bottom: 0.5rem;">Name</label>
              <input type="text" placeholder="Your name" required style="width: 100%; padding: 0.9rem 1rem; background: #111; border: 1px solid rgba(201, 168, 124, 0.06); border-radius: 6px; color: var(--petal-text); font-size: 0.95rem; outline: none; transition: all 0.4s;">
            </div>
            <div>
              <label style="display: block; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--petal-muted); margin-bottom: 0.5rem;">Email</label>
              <input type="email" placeholder="your@email.com" required style="width: 100%; padding: 0.9rem 1rem; background: #111; border: 1px solid rgba(201, 168, 124, 0.06); border-radius: 6px; color: var(--petal-text); font-size: 0.95rem; outline: none; transition: all 0.4s;">
            </div>
          </div>
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--petal-muted); margin-bottom: 0.5rem;">I'm interested in</label>
            <select required style="width: 100%; padding: 0.9rem 1rem; background: #111; border: 1px solid rgba(201, 168, 124, 0.06); border-radius: 6px; color: var(--petal-text); font-size: 0.95rem; outline: none; transition: all 0.4s;">
              <option value="">Select a service...</option>
              <option value="floral-design">Floral Design</option>
              <option value="installation">Spatial Installation</option>
              <option value="creative-direction">Creative Direction</option>
              <option value="workshop">Workshop Registration</option>
              <option value="other">Something Else</option>
            </select>
          </div>
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--petal-muted); margin-bottom: 0.5rem;">Tell us about your project</label>
            <textarea placeholder="Share your vision, timeline, and any inspiration..." required style="width: 100%; padding: 0.9rem 1rem; background: #111; border: 1px solid rgba(201, 168, 124, 0.06); border-radius: 6px; color: var(--petal-text); font-size: 0.95rem; outline: none; transition: all 0.4s; min-height: 120px; resize: vertical;"></textarea>
          </div>
          <button type="submit" style="padding: 1rem 2rem; background: var(--petal-accent); color: var(--petal-bg); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; border: 1px solid var(--petal-accent); border-radius: 6px; cursor: pointer; transition: all 0.5s; margin-top: 0.5rem;">Send Inquiry</button>
        </form>
      </div>
    </section>

    <!-- Footer -->
    <footer style="background: #111; padding: 4rem 3rem 2rem; border-top: 1px solid rgba(201, 168, 124, 0.06);">
      <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 2rem;">
        <div>
          <a href="#" style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.25rem; font-weight: 500; color: var(--petal-text); text-decoration: none; display: flex; align-items: center; gap: 0.6rem;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--petal-accent);"></span>
            Petal Doctrine
          </a>
          <p style="font-size: 0.85rem; color: var(--petal-muted); margin-top: 0.5rem; font-weight: 300;">Floral Atelier & Creative Studio</p>
        </div>
        <ul style="display: flex; gap: 2rem; list-style: none;">
