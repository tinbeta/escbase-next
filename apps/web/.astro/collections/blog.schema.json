{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "tagIcon": {
      "default": "fas fa-newspaper",
      "type": "string"
    },
    "tagColor": {
      "default": "#2563eb",
      "type": "string"
    },
    "readTime": {
      "default": "5 min read",
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "image": {
      "type": "string"
    },
    "ogImage": {
      "type": "string"
    },
    "author": {
      "default": "Escbase",
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "excerpt",
    "date",
    "tag"
  ]
}